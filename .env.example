# ============================================================
# COPY THIS FILE TO .env AND FILL IN ALL VALUES
# NEVER COMMIT .env TO GITHUB
# ============================================================

# --- GENERAL ---
DOMAIN=company.com
TZ=Asia/Beirut
SERVER_LOCATION=A   # A or B

# --- TRAEFIK ---
TRAEFIK_ACME_EMAIL=admin@company.com
TRAEFIK_DASHBOARD_USER=admin
# Generate password hash: echo $(htpasswd -nb admin yourpassword)
TRAEFIK_DASHBOARD_PASSWORD_HASH=

# --- NEXTCLOUD ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_TRUSTED_DOMAINS=files.company.com

# --- ONLYOFFICE ---
# Generate a strong random secret: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=

# --- PORTAINER ---
# No env needed - set up via UI on first run

# --- NETDATA ---
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=

# --- DUPLICATI ---
DUPLICATI_PASSWORD=

# --- ADGUARD ---
# Set up via UI on first run

# --- WATCHTOWER ---
# Watchtower only auto-updates safe services (NOT Nextcloud/ONLYOFFICE)
# Nextcloud and ONLYOFFICE are updated manually to avoid breaking changes
WATCHTOWER_NOTIFICATION_EMAIL=jad@forterix.com
WATCHTOWER_SMTP_HOST=smtp.resend.com
WATCHTOWER_SMTP_PORT=465
WATCHTOWER_SMTP_USER=resend
WATCHTOWER_SMTP_PASSWORD=

# --- TAILSCALE ---
TAILSCALE_AUTH_KEY=

# --- BACKBLAZE B2 (offsite backup) ---
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=company-server-backup
